{
  "display_information": {
    "name": "Ask Ops",
    "description": "Ask ops for an automation, a dashboard fix or a CRM change, and follow its progress.",
    "background_color": "#5056ce"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Ask Ops",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/askops",
        "description": "Ask ops for an automation, a dashboard fix or a CRM change",
        "usage_hint": "[short description]",
        "url": "https://revops-desk.vercel.app/slack/interactions/",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Create Ask Ops ticket",
        "type": "global",
        "callback_id": "revops_create",
        "description": "Submit a request to the RevOps team"
      },
      {
        "name": "Create Ask Ops ticket",
        "type": "message",
        "callback_id": "revops_message",
        "description": "Turn this message into a RevOps request"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "users:read",
        "users:read.email",
        "files:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://revops-desk.vercel.app/slack/interactions/",
      "bot_events": [
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://revops-desk.vercel.app/slack/interactions/"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
